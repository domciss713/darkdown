# Public URL
NEXT_PUBLIC_SITE_URL=https://darkdown.xyz

# NextAuth
NEXTAUTH_URL=https://darkdown.xyz
NEXTAUTH_SECRET=replace_me_with_strong_secret
AUTH_SECRET=replace_me_with_strong_secret

# Database
DATABASE_URL=postgresql://user:pass@neon-host/db

# Optional Cloudflare Turnstile (for login/register anti-bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Query (Minecraft status)
QUERY_HOST=play.darkdown.xyz
QUERY_PORT=25565

# RCON
RCON_HOST=play.darkdown.xyz
RCON_PORT=25575
RCON_PASSWORD=changeme
RCON_ALLOWED=say,whitelist,tellraw,lp,user,kick,warn

# SFTP logs
SFTP_HOST=sftp.hostify.cz
SFTP_USER=u12345
SFTP_PASS=replace_me
SFTP_LOG_PATH=/servers/yourServer/logs/latest.log

# Attachments storage (S3 compatible)
STORAGE_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
STORAGE_S3_BUCKET=darkdown-attachments
STORAGE_S3_REGION=eu-west-1
STORAGE_S3_ACCESS_KEY_ID=your_key
STORAGE_S3_SECRET_ACCESS_KEY=your_secret

# Mail (Resend)
RESEND_API_KEY=re_xxx
MAIL_FROM=no-reply@darkdown.xyz
APP_NAME=DarkDowN

# Ticket mail notifications
TICKET_ADMIN_EMAILS=admin1@darkdown.xyz,admin2@darkdown.xyz
TICKET_HELPER_EMAILS=helper1@darkdown.xyz,helper2@darkdown.xyz

# Access control
ADMIN_USER_IDS=your_user_id
HELPER_USER_IDS=helper_user_id_1,helper_user_id_2

# UI role mapping (nicknames shown as VIP in /me when role is USER)
MC_VIP_NICKS=PlayerNick1,PlayerNick2
